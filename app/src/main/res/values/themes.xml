<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- アプリ全体テーマ（Material 3） -->
    <style name="Theme.Homemascot" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">#3f51b5</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Surface colors -->
        <item name="colorSurface">#f5f5f5</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorOnSurfaceVariant">#666666</item>
    </style>

    <!-- メモ入力専用、ActionBar無し -->
    <style name="Theme.Homemascot.NoActionBar" parent="Theme.Material3.Light.NoActionBar">
